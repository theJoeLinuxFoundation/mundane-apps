#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/../.."
work=$(realpath -m "${1:?pass a new output directory}")
mkdir -p "$work"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/target}"
for variant in may pin; do
    mkdir -p "$work/$variant"
    cp -r tests/cost/{Cargo.toml,src} "$work/$variant/"
    flags=()
    if [[ $variant == may ]]; then
        git show 99126ec:Cargo.lock >"$work/may/Cargo.lock"
        sed -i 's/f4fe0be1f8c7974db07e01c5cd05bee0cf4eb8d9/deb48ceb47125223df73902d1c3b72f2f442222b/g' "$work/may/Cargo.toml"
    else
        cp Cargo.lock "$work/pin/Cargo.lock"
        flags+=(--features bridge)
    fi
    cargo build --release --manifest-path "$work/$variant/Cargo.toml" "${flags[@]}"
    cp "$CARGO_TARGET_DIR/release/mundane-frame-cost" "$work/$variant-bin"
done
if [[ ${2:-} == --trace ]]; then
    source=$(cargo metadata --format-version 1 --locked | python3 -c 'import json,sys,pathlib; print(next(pathlib.Path(p["manifest_path"]).parents[2] for p in json.load(sys.stdin)["packages"] if p["name"]=="gpui"))')
    python3 tests/cost/instrument.py "$source" "$work"
    cargo build --features trace --release --manifest-path "$work/trace/Cargo.toml"
    cp "$CARGO_TARGET_DIR/release/mundane-frame-cost" "$work/trace-bin"
fi
